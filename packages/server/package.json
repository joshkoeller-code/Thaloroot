    "dev": "tsx src/node.ts"
  },
  "dependencies": {
    "@thaloroot/engine": "0.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
