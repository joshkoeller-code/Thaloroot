{
  "name": "@thaloroot/server",
  "version": "0.1.0",
  "description": "Thaloroot game rooms: the TV, the phones, and the computer players, kept in sync.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
