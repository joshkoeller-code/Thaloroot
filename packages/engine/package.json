{
  "name": "@thaloroot/engine",
  "version": "0.1.0",
  "description": "Rules engine for Thaloroot: a serializable state machine, content loader, bots, and a simulator.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sim": "tsx src/cli/sim.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@thaloroot/content": "0.1.0"
  }
}
